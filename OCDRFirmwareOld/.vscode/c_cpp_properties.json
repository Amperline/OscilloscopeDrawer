{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/headers/**",
                "${env:AVR_TOOLCHAIN}/avr/include"
            ],
            "defines": [
                "__AVR_ATmega16__"
            ],
            "compilerPath": "${env:AVR_TOOLCHAIN}/bin/avr-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/headers"
            ],
            "defines": [
                "__AVR_ATmega16__"
            ],
            "compilerPath": "/usr/bin/avr-gcc", 
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}