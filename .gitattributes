# Встановити поведінку за замовчуванням:
# Автоматично нормалізувати закінчення рядків для всіх текстових файлів (в LF у репозиторії)
* text=auto

# Примусово використовувати LF для файлів KiCad, навіть на Windows
*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_mod text eol=lf
*.kicad_sym text eol=lf
*.kicad_wks text eol=lf
*.fp-lib-table text eol=lf
*.sym-lib-table text eol=lf