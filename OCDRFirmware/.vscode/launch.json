{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F401CCU",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/OscllscDrwr_firm.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "stlink",
      "device": "STM32F401CCUx",
      "interface": "swd",
      // "runToEntryPoint": null,
      "gdbPath": "${env:STM_COMPILER}/arm-none-eabi-gdb.exe",
      "svdFile": "${workspaceFolder}/STM32F401.svd",
      "postRestartCommands": [
        "monitor reset halt"
      ],
      "showDevDebugOutput": "raw",
      "debuggerArgs": [],
    }
  ]
}
